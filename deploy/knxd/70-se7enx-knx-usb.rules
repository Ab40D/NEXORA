# SE7ENX: give the "se7enx-knx" group access to KNX USB interfaces, so the knxd container can open
# them without running as root. Install on the HOST (Arch Linux: as root):
#   groupadd --system se7enx-knx
#   cp 70-se7enx-knx-usb.rules /etc/udev/rules.d/ && udevadm control --reload && udevadm trigger
#   getent group se7enx-knx          # put the GID into .env as KNXD_GID
# Then unplug and re-plug the interface (or reboot) and restart the knxd container.
# IDs below are the USB-HID KNX interfaces listed by knxd 0.14.73 (60-knxd.rules). If yours is
# missing, add a line with the IDs shown by `lsusb`.
ACTION!="add", GOTO="se7enx_knx_end"
SUBSYSTEM!="usb", GOTO="se7enx_knx_end"
ENV{DEVTYPE}!="usb_device", GOTO="se7enx_knx_end"

ATTR{idVendor}=="04cc", ATTR{idProduct}=="0301", GROUP="se7enx-knx", MODE="0660"
ATTR{idVendor}=="0e77", ATTR{idProduct}=="0111", GROUP="se7enx-knx", MODE="0660"
ATTR{idVendor}=="0e77", ATTR{idProduct}=="0112", GROUP="se7enx-knx", MODE="0660"
