# SE7ENX appliance settings. Copy to .env next to compose.yaml. Contains NO secrets.
# Every setting is optional; the defaults are safe. Never commit the real .env.

# --- Compose-only (used by compose.yaml, not by SE7ENX) ------------------------------------
# SE7ENX_IMAGE=se7enx:2.0.0          # pin a version; change it to upgrade or roll back
# SE7ENX_HTTP_PORT=8787               # port on this machine
# SE7ENX_BIND_ADDRESS=0.0.0.0         # e.g. 192.168.1.10 to publish on one interface only

# --- Access ----------------------------------------------------------------------------------
# Host names you use to open SE7ENX. "auto" accepts IP addresses, localhost, *.local and *.home.arpa.
SE7ENX_ALLOWED_HOSTS=auto
# SE7ENX_ALLOWED_HOSTS=auto,se7enx.example.lan

# Pairing: leave unset for random single-use codes (shown by `docker compose logs se7enx`).
# SE7ENX_PAIRING_CODE=
# SE7ENX_SESSION_TTL_HOURS=12

# Demo: add simulated devices when the device list is empty (never touches hardware).
SE7ENX_SAMPLE_DEVICES=true

# --- Home Assistant (optional; can also be set in the UI: Devices -> Integrations) -----------
# Use an address the CONTAINER can reach, e.g. http://192.168.1.20:8123 or http://homeassistant.local:8123.
# SE7ENX_HA_URL=http://192.168.1.20:8123
# Token as a Docker secret (preferred, see compose.yaml) ...
# SE7ENX_HA_TOKEN_FILE=/run/secrets/ha_token
# SE7ENX_HA_VERIFY_TLS=true

# --- Shelly (devices are added in the UI by IP address) ---------------------------------------
# SE7ENX_SHELLY_POLL_S=5

# --- KNX (optional) ----------------------------------------------------------------------------
# SE7ENX_KNX_AUTOCONNECT=true
# SE7ENX_KNX_CONNECTION_TYPE=tunneling_tcp      # TCP tunnelling works through Docker's bridge network
# SE7ENX_KNX_GATEWAY_IP=192.168.1.30
# SE7ENX_KNX_GATEWAY_PORT=3671
# SE7ENX_KNX_ROUTE_BACK=true                    # needed for UDP tunnelling ("tunneling") behind NAT
# Optional operator ceiling for every KNX group address the hub may use:
# SE7ENX_ALLOWED_GROUP_ADDRESSES=1/1/*,2/1/1-20

# --- Safety & logging --------------------------------------------------------------------------
# SE7ENX_DEVICE_MIN_INTERVAL_MS=300
# SE7ENX_LOG_LEVEL=INFO

# --- HTTPS (needed for camera gestures and voice from phones and other computers) ----------------
# Easiest: the SE7ENX local CA (docker compose -f compose.yaml -f compose.https.yaml up -d).
# SE7ENX_TLS_HOSTS=192.168.1.10              # this computer's LAN IP (comma-separate more names/IPs)
# SE7ENX_REDIRECT_PORT=8780                  # compose-only: published port of the CA/redirect helper
# Or your own certificate: mount ./certs in compose.yaml, then
# SE7ENX_TLS_CERT=/certs/cert.pem
# SE7ENX_TLS_KEY=/certs/key.pem

# --- Local speech-to-text (optional; docker compose --profile speech up -d) ----------------------
# SE7ENX_STT_URL=http://speech:8000/v1
# SE7ENX_SPEECH_MODEL=base                   # tiny | base | small (better for French/Arabic) | medium
# SE7ENX_SPEECH_OFFLINE=false                # true once the model is in the se7enx-speech-models volume

# --- KNX USB interface via knxd (optional; see compose.knx-usb.yaml) ----------------------------
# KNXD_GID=                                  # getent group se7enx-knx   (after installing the udev rule)
# KNXD_ADDRESS=1.1.250                       # FREE individual address for knxd on your line
# KNXD_CLIENT_ADDRESSES=1.1.240:4            # FREE addresses for tunnelling clients (the hub uses one)
# KNXD_DRIVER=usb:                           # or tpuart:/dev/ttyKNX1, ft12:/dev/ttyUSB0
