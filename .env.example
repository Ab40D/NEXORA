# SE7ENX web app (Next.js / Vercel) — example configuration.
# Copy to .env.local for local development. This file contains NO secrets and
# the web app needs none: KNX credentials, KNX Secure keys and Home Assistant
# tokens never live in the frontend or on Vercel.

# Default URL pre-filled in the "Local KNX Bridge" wizard step (optional).
# The browser connects to the bridge directly; Vercel never proxies to it.
NEXT_PUBLIC_DEFAULT_BRIDGE_URL=http://127.0.0.1:8787

# Optional override for the hand-landmark model. Default is the self-hosted,
# checksum-verified copy at /models/hand_landmarker.task.
# NEXT_PUBLIC_HAND_MODEL_URL=/models/hand_landmarker.task

# Optional override for the MediaPipe WASM runtime base path (default: /mediapipe/wasm).
# NEXT_PUBLIC_MEDIAPIPE_WASM_BASE=/mediapipe/wasm

# Clickjacking protection: who may embed the app in an iframe.
# Default (unset) is 'none'. Example: SE7ENX_FRAME_ANCESTORS='self'
# SE7ENX_FRAME_ANCESTORS=

# Development only: extra origins allowed to load the Next.js dev server
# (comma separated hostnames), e.g. when previewing through a tunnel.
# SE7ENX_ALLOWED_DEV_ORIGINS=

# DEVELOPMENT / DEMO ONLY (build time): same-origin rewrite /demo-bridge/* -> ONE fixed
# bridge URL, for preview environments that cannot expose a second host. Never set this
# for production deployments; Vercel cannot reach private networks anyway.
# SE7ENX_DEV_BRIDGE_REWRITE=http://127.0.0.1:8787
